# ===========================================
# FraudShield Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ---- Database ----
DB_URL=jdbc:mysql://localhost:3306/fraudshield?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ---- JWT ----
JWT_SECRET=your-super-secret-key-that-is-at-least-256-bits-long
JWT_EXPIRATION=86400000

# ---- Server ----
SERVER_PORT=8080

# ---- ML Service ----
ML_SERVICE_URL=http://localhost:8000
